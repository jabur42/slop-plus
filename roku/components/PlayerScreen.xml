<?xml version="1.0" encoding="utf-8"?>
<component name="PlayerScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" onChange="onParams"/>
    <field id="focusMe" type="boolean" alwaysNotify="true" onChange="onFocusMe"/>
    <field id="navigate" type="assocarray" alwaysNotify="true"/>
    <field id="closing" type="boolean" onChange="onClosing"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Utils.brs"/>
  <script type="text/brightscript" uri="pkg:/components/PlayerScreen.brs"/>
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF"/>
    <Video id="video" width="1920" height="1080" enableUI="false" visible="false"/>

    <!-- Legendas desenhadas pelo app (estilo controlado pelo usuário) -->
    <Group id="subs"/>

    <!-- Tela de carregamento -->
    <Group id="loader">
      <Backdrop id="hero" dim="0.4"/>
      <Poster uri="pkg:/images/shade.png" width="1920" height="1080" loadWidth="1280" loadHeight="720"/>
      <Poster uri="pkg:/images/logo.png" width="150" height="50" translation="[96,56]"/>
      <Poster id="loadSpinner" uri="pkg:/images/spinner.png" width="112" height="112" translation="[904,330]" scaleRotateCenter="[56,56]"/>
      <Label id="lTitle" translation="[160,500]" width="1600" horizAlign="center" color="0xFFFFFFFF"/>
      <Label id="lSub" translation="[160,572]" width="1600" horizAlign="center" color="0xD0D0DAFF"/>
      <Label id="lSource" translation="[260,622]" width="1400" horizAlign="center" color="0x7C7C8AFF"/>
      <Label id="lPhase" translation="[160,730]" width="1600" horizAlign="center" color="0xFFFFFFFF"/>
      <Label id="lInfo" translation="[160,782]" width="1600" horizAlign="center" color="0xB4B4C2FF"/>
      <Label id="lHint" translation="[160,990]" width="1600" horizAlign="center" color="0x7C7C8AFF" text="Voltar para cancelar"/>
    </Group>

    <!-- Indicador de buffering / seek durante a reprodução -->
    <Group id="busy" visible="false">
      <Poster id="busySpinner" uri="pkg:/images/spinner.png" width="96" height="96" translation="[912,452]" scaleRotateCenter="[48,48]"/>
      <Label id="busyLabel" translation="[0,570]" width="1920" horizAlign="center" color="0xFFFFFFFF"/>
    </Group>

    <!-- Controles -->
    <Group id="controls" visible="false">
      <Poster uri="pkg:/images/top_shade.png" width="1920" height="280"/>
      <Label id="cTitle" translation="[96,52]" width="1500" color="0xFFFFFFFF"/>
      <Label id="cSub" translation="[96,110]" width="1500" color="0xB4B4C2FF"/>
      <Poster uri="pkg:/images/bottom_shade.png" width="1920" height="420" translation="[0,660]"/>
      <Group id="bar" translation="[96,880]">
        <Rectangle width="1728" height="8" color="0xFFFFFF40"/>
        <Rectangle id="buffered" height="8" color="0xFFFFFF70"/>
        <Rectangle id="played" height="8" color="0x8B5CF6FF"/>
        <Poster id="knob" uri="pkg:/images/circle.png" width="28" height="28" translation="[-14,-10]" scaleRotateCenter="[14,14]"/>
        <Label id="preview" translation="[0,-64]" width="200" horizAlign="center" color="0xFFFFFFFF" visible="false"/>
      </Group>
      <Label id="tCur" translation="[96,902]" color="0xD0D0DAFF"/>
      <Label id="tEnd" translation="[96,902]" width="1728" horizAlign="right" color="0xD0D0DAFF"/>
      <Group id="buttons" translation="[0,948]">
        <Group translation="[776,0]"><Poster uri="pkg:/images/circle.png" width="88" height="88"/><Poster uri="pkg:/images/ic_rew.png" width="56" height="56" translation="[16,16]"/></Group>
        <Group translation="[916,0]"><Poster uri="pkg:/images/circle.png" width="88" height="88"/><Poster uri="pkg:/images/ic_pause.png" width="56" height="56" translation="[16,16]"/></Group>
        <Group translation="[1056,0]"><Poster uri="pkg:/images/circle.png" width="88" height="88"/><Poster uri="pkg:/images/ic_fwd.png" width="56" height="56" translation="[16,16]"/></Group>
        <Group translation="[1544,0]"><Poster uri="pkg:/images/circle.png" width="88" height="88"/><Poster uri="pkg:/images/ic_cc.png" width="56" height="56" translation="[16,16]"/></Group>
        <Group translation="[1640,0]"><Poster uri="pkg:/images/circle.png" width="88" height="88"/><Poster uri="pkg:/images/ic_audio.png" width="56" height="56" translation="[16,16]"/></Group>
        <Group translation="[1736,0]"><Poster uri="pkg:/images/circle.png" width="88" height="88"/><Poster uri="pkg:/images/ic_style.png" width="56" height="56" translation="[16,16]"/></Group>
      </Group>
      <Label id="btnName" translation="[0,1046]" width="200" horizAlign="center" color="0xD0D0DAFF" visible="false"/>
    </Group>

    <!-- Painel lateral: legendas / áudio / estilo -->
    <Group id="panel" visible="false" translation="[1240,0]">
      <Rectangle width="680" height="1080" color="0x141419F2"/>
      <Label id="pTitle" translation="[56,72]" width="580" color="0xFFFFFFFF"/>
      <Label id="pHint" translation="[56,132]" width="580" color="0x7C7C8AFF"/>
      <RadioButtonList id="radio" translation="[36,196]" itemSize="[608,72]" numRows="11" itemSpacing="[0,4]"
        color="0xD0D0DAFF" focusedColor="0x0E0E12FF" focusBitmapUri="pkg:/images/pill.9.png"
        vertFocusAnimationStyle="floatingFocus"/>
      <LabelList id="styleList" translation="[36,196]" itemSize="[608,72]" numRows="6" itemSpacing="[0,4]"
        color="0xD0D0DAFF" focusedColor="0x0E0E12FF" focusBitmapUri="pkg:/images/pill.9.png"
        vertFocusAnimationStyle="floatingFocus" visible="false"/>
    </Group>

    <Timer id="hideTimer" duration="5"/>
    <Timer id="seekTimer" duration="0.9"/>
    <Timer id="pollTimer" duration="1.5" repeat="true"/>
    <Timer id="subTimer" duration="0.2" repeat="true"/>
    <Timer id="reportTimer" duration="10" repeat="true"/>
    <Animation id="spinA" duration="1.0" repeat="true" easeFunction="linear">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, -6.2832]" fieldToInterp="loadSpinner.rotation"/>
    </Animation>
    <Animation id="spinB" duration="1.0" repeat="true" easeFunction="linear">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, -6.2832]" fieldToInterp="busySpinner.rotation"/>
    </Animation>
  </children>
</component>
